apiVersion: v1
kind: Secret
metadata:
  name: farmer-saathi-secrets
  labels:
    app: farmer-saathi
type: Opaque
stringData:
  DATABASE_URL: "postgresql://farmer_admin:farmer_secure_password@postgres-service:5432/farmer_saathi"
  REDIS_URL: "redis://redis-service:6379"
  JWT_SECRET: "replace-with-a-very-secure-jwt-secret-key-at-least-32-chars"
  GROQ_API_KEY: "gsk_your_groq_api_key_here"
  SARVAM_API_KEY: "sk_your_sarvam_api_key_here"
  FIREBASE_PROJECT_ID: "your-firebase-project-id"
  FIREBASE_CLIENT_EMAIL: "firebase-adminsdk@your-project.iam.gserviceaccount.com"
  FIREBASE_PRIVATE_KEY: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
