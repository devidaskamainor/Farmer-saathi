PORT=4000
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Reverse proxy support (Nginx, Caddy, Cloudflare, AWS ALB, Render).
# Set to 1 (or number of reverse proxy hops) so Express and express-rate-limit trust X-Forwarded-For headers.
TRUST_PROXY=1

# Standalone PostgreSQL connection. Use a URL-encoded password if it contains special characters.
# Neon hosts use TLS with certificate and hostname validation.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Session cookie. Use SameSite=none and Secure=true only when the UI and API are cross-site.
SESSION_COOKIE_NAME=farmer_saathi_session
SESSION_DURATION_DAYS=14
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# Google OAuth 2.0 / Google Identity Services authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Authentication (for Authorization: Bearer <token> headers and API/mobile clients)
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
JWT_EXPIRES_IN=14d

# Gmail SMTP defaults. Use a Gmail App Password, not your regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=Farmer Saathi <your-email@example.com>
API_PUBLIC_URL=http://localhost:4000

# One-time migration only; use a read-only source credential, never a VITE_ variable.
SUPABASE_DATABASE_URL=
SUPABASE_DATABASE_SSL=true
SUPABASE_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional external services
# Firebase Cloud Messaging (FCM) credentials for instant push notifications
# You can provide either the inline JSON string (FIREBASE_SERVICE_ACCOUNT) or individual fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Redis caching (optional). If omitted or unreachable, an in-memory cache with TTL is used automatically.
REDIS_URL=redis://localhost:6379

# Apache Kafka message queue (optional). If omitted or unreachable, an in-memory fallback queue is used automatically.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=farmer-saathi
KAFKA_ENABLED=true
SARVAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
WEATHER_API_KEY=
AGMARKNET_API_KEY=
# Optional override for the official data.gov.in AGMARKNET resource.
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070


# Farm planner alert thresholds; defaults are cautious general indicators, not crop-specific prescriptions.
FARM_ALERT_HEAVY_RAIN_MM=25
FARM_ALERT_SEVERE_RAIN_MM=50
FARM_ALERT_HIGH_TEMPERATURE_C=38
FARM_ALERT_DRY_DAY_RAIN_MM=1
FARM_ALERT_DRY_SPELL_DAYS=3
FARM_SOIL_MOISTURE_LOW_PCT=30
FARM_SOIL_MEASUREMENT_MAX_AGE_DAYS=3
