{
  "name": "farmer-advisory-assistant",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names \"API,UI\" -c \"cyan,magenta\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "test:all": "node scripts/verify-k8s-docker.mjs && npm run test -w server && npm run build -w client",
    "docker:build": "docker build -t farmer-saathi:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "k8s:verify": "node scripts/verify-k8s-docker.mjs",
    "k8s:apply": "kubectl apply -k k8s",
    "k8s:delete": "kubectl delete -k k8s",
    "db:config": "npm run db:config -w server",
    "start": "npm run start -w server",
    "open": "node -e \"import('node:child_process').then(cp => cp.exec(process.platform === 'win32' ? 'start http://localhost:4000' : process.platform === 'darwin' ? 'open http://localhost:4000' : 'xdg-open http://localhost:4000'))\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "redis": "^6.3.1",
    "sarvamai": "^1.1.21"
  }
}
