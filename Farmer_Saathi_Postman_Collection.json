{
  "info": {
    "_postman_id": "farmer-saathi-api-v1",
    "name": "Farmer Saathi API",
    "description": "Complete Postman collection for the Farmer Saathi Agricultural Advisory Platform.\nIncludes Auth, AI advisory, Mandi trends, Weather, Government Schemes, Push Notifications (FCM), and Voice services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Checks system health, database connection, Redis cache, and Firebase FCM status."
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Farmer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.environment.set('jwt_token', res.token);",
                  "        console.log('Saved jwt_token to environment');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ramesh Patel\",\n  \"email\": \"farmer.ramesh@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"phone\": \"+919876543210\",\n  \"state\": \"Karnataka\",\n  \"district\": \"Mandya\",\n  \"preferredLanguage\": \"kn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new farmer account. Automatically sets {{jwt_token}} on success."
          }
        },
        {
          "name": "Login Farmer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.environment.set('jwt_token', res.token);",
                  "        console.log('Saved jwt_token to environment');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer.ramesh@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Logs in farmer and automatically stores the JWT Bearer token into {{jwt_token}}."
          }
        },
        {
          "name": "Social Login (Google / OAuth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.environment.set('jwt_token', res.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"account\": {\n    \"email\": \"ramesh.patel@gmail.com\",\n    \"name\": \"Ramesh Patel\",\n    \"id\": \"google-oauth2-123456\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/social-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "social-login"]
            }
          }
        },
        {
          "name": "Get Session Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer.ramesh@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Push Notifications & FCM",
      "item": [
        {
          "name": "FCM Health & Config",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "health"]
            },
            "description": "Reports Firebase Admin SDK connection, active project ID, and recent dispatches."
          }
        },
        {
          "name": "Send Test Push Notification",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"🌾 Harvest Advisory Alert\",\n  \"body\": \"FCM push notification is active and delivering live updates!\",\n  \"actionUrl\": \"/dashboard\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/test-dispatch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "test-dispatch"]
            },
            "description": "Sends an immediate test push notification through Google Firebase Cloud Messaging."
          }
        },
        {
          "name": "Trigger Holiday / Festival Alert",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/trigger-holiday",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "trigger-holiday"]
            },
            "description": "Detects the upcoming Indian agricultural festival/holiday and broadcasts a push notification."
          }
        },
        {
          "name": "Trigger Feature Announcement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"🚀 New Feature: Multi-Language Voice Advisory\",\n  \"body\": \"You can now speak in Kannada, Hindi, Telugu, and 10 other Indian languages!\",\n  \"actionUrl\": \"/assistant\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/trigger-feature",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "trigger-feature"]
            }
          }
        },
        {
          "name": "Get Notifications List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"]
            }
          }
        },
        {
          "name": "Get Upcoming Holidays Catalog",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/holidays",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "holidays"]
            }
          }
        },
        {
          "name": "Register FCM Device Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"sample-device-registration-token-12345\",\n  \"deviceType\": \"web\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/fcm-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "fcm-token"]
            }
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "read-all"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Farmer Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/farmers/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farmers", "me"]
            }
          }
        },
        {
          "name": "Update Preferred Language",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preferredLanguage\": \"kn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/farmers/me/preferred-language",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farmers", "me", "preferred-language"]
            }
          }
        }
      ]
    },
    {
      "name": "5. AI Advisory (Groq & Llama)",
      "item": [
        {
          "name": "Chat Advisory (Multilingual)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"ನನ್ನ ಟೊಮೇಟೊ ಬೆಳೆ ಹಳದಿ ಎಲೆಗಳಾಗುತ್ತಿವೆ, ನಾನು ಏನು ಮಾಡಬೇಕು?\",\n  \"language\": \"kn\",\n  \"context\": {\n    \"state\": \"Karnataka\",\n    \"crop\": \"Tomato\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ai", "chat"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Mandi & Market Prices",
      "item": [
        {
          "name": "Get Mandi Prices",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mandi?commodity=Tomato&state=Karnataka",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mandi"],
              "query": [
                { "key": "commodity", "value": "Tomato" },
                { "key": "state", "value": "Karnataka" }
              ]
            }
          }
        },
        {
          "name": "Get Mandi Price Trends",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mandi/trends?commodity=Tomato&market=Bangalore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mandi", "trends"],
              "query": [
                { "key": "commodity", "value": "Tomato" },
                { "key": "market", "value": "Bangalore" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7. Weather Advisory",
      "item": [
        {
          "name": "Get 7-Day Farm Weather Forecast",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/weather?lat=12.9716&lon=77.5946",
              "host": ["{{baseUrl}}"],
              "path": ["api", "weather"],
              "query": [
                { "key": "lat", "value": "12.9716" },
                { "key": "lon", "value": "77.5946" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "8. Government Schemes",
      "item": [
        {
          "name": "List Government Schemes",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/schemes?state=Karnataka&lang=kn",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schemes"],
              "query": [
                { "key": "state", "value": "Karnataka" },
                { "key": "lang", "value": "kn" }
              ]
            }
          }
        },
        {
          "name": "Get Scheme Detail",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/schemes/pm-kisan?lang=en",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schemes", "pm-kisan"],
              "query": [{ "key": "lang", "value": "en" }]
            }
          }
        }
      ]
    },
    {
      "name": "9. Farm Planner & History",
      "item": [
        {
          "name": "Get Farm History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/farmers/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farmers", "history"]
            }
          }
        },
        {
          "name": "Add Farm History Record",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"crop\": \"Tomato\",\n  \"variety\": \"Hybrid-1\",\n  \"season\": \"Kharif\",\n  \"acreage\": 2.5,\n  \"yieldQuintal\": 45,\n  \"sowingDate\": \"2026-06-15\",\n  \"notes\": \"Drip irrigation used.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/farmers/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "farmers", "history"]
            }
          }
        },
        {
          "name": "Get Farm Planner Assessment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/planner",
              "host": ["{{baseUrl}}"],
              "path": ["api", "planner"]
            }
          }
        }
      ]
    },
    {
      "name": "10. Voice & Audio (Sarvam AI)",
      "item": [
        {
          "name": "Text to Speech (Speak)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"ನಮಸ್ಕಾರ ರೈತ ಮಿತ್ರ, ನಿಮ್ಮ ಬೆಳೆಗೆ ನೀರಾವರಿ ಸರಿಯಾಗಿ ನೀಡಲಾಗಿದೆ.\",\n  \"language\": \"kn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/voice/speak",
              "host": ["{{baseUrl}}"],
              "path": ["api", "voice", "speak"]
            }
          }
        }
      ]
    }
  ]
}
