{
  "info": {
    "_postman_id": "farmer-saathi-api-v1",
    "name": "Farmer Saathi API",
    "description": "Complete Postman collection for the Farmer Saathi Agricultural Advisory Platform.\nIncludes Auth, AI advisory, Mandi trends, Weather, Government Schemes, Push Notifications (FCM), and Voice services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Checks system health, database connection, Redis cache, and Firebase FCM status."
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Farmer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200, 201 or 409\", function () {",
                  "    pm.expect([200, 201, 409]).to.include(pm.response.code);",
                  "});",
                  "try {",
                  "    var res = pm.response.json();",
                  "    if (res && res.token) {",
                  "        pm.environment.set(\"jwt_token\", res.token);",
                  "        pm.collectionVariables.set(\"jwt_token\", res.token);",
                  "    }",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Patel\",\n  \"fullName\": \"Ramesh Patel\",\n  \"email\": \"farmer.ramesh@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"phone\": \"+919876543210\",\n  \"state\": \"Karnataka\",\n  \"district\": \"Mandya\",\n  \"preferredLanguage\": \"kn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new farmer account. Automatically sets {{jwt_token}} on success."
          }
        },
