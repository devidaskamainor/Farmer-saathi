{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false
  },
  "include": [
    "client/src/**/*",
    "client/public/**/*",
    "client/vite.config.js",
    "server/src/**/*",
    "server/test/**/*"
  ],
  "exclude": [
    "node_modules",
    "client/node_modules",
    "server/node_modules",
    "dist",
    "client/dist"
  ]
}
