# Auto detect text files and perform LF normalization
* text=auto

# Enforce LF on container and script files for Linux cross-platform compatibility
Dockerfile text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
.env* text eol=lf
